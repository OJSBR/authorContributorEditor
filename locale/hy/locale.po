msgid "plugins.generic.authorContributorEditor.displayName"
msgstr "Հեղինակի համար ներդրողների խմբագիր"

#, fuzzy
msgid "plugins.generic.authorContributorEditor.description"
msgstr "Հեղինակներին վերադարձնում է իրենց ներկայացումների ներդրողների ցանկը խմբագրելու հնարավորությունը՝ ինչպես OJS 3.3-ում և 3.4-ում։ OJS 3.5-ում «Ներդրողներ» վահանակը հեղինակների համար միշտ միայն ընթերցելի է, նույնիսկ երբ նրանց օգտվողների խմբում միացված է «Թույլատրել ներկայացման մետատվյալների խմբագրումը»։ Այս հավելումը վերականգնում է այդ իրավունքը միայն միջերեսում. որոշողը մնում է օգտվողների խմբի կարգավորումը և փուլին նշանակումը՝ ճիշտ այնպես, ինչպես OJS-ի միջուկն արդեն կիրառում է սերվերում։"
