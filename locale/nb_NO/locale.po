#, fuzzy
msgid "plugins.generic.authorContributorEditor.displayName"
msgstr "Bidragsyterredigering for forfattere"

#, fuzzy
msgid "plugins.generic.authorContributorEditor.description"
msgstr "Gir forfattere tilbake muligheten til å redigere bidragsyterlisten i sine egne innsendinger, slik som i OJS 3.3 og 3.4. I OJS 3.5 er Bidragsytere-panelet alltid skrivebeskyttet for forfattere, selv når brukergruppen deres har «Tillat redigering av innsendingens metadata» slått på. Dette tillegget gjenoppretter bare den tillatelsen i grensesnittet: det avgjørende er fortsatt innstillingen for brukergruppen og trinntildelingen, akkurat slik OJS-kjernen allerede håndhever på serveren."
